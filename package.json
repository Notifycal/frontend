{
  "name": "frontend",
  "author": "Notifycal",
  "description": "Private-area frontend SPA",
  "keywords": [
    "vite",
    "react",
    "tanstack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Notifycal/frontend"
  },
  "license": "MIT",
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "types": "tsc",
    "dev": "$npm_execpath run dev:config && vite",
    "dev:config": "cp config/config.local.js public/config.js",
    "build": "rm -rf public/config.js && tsc && vite build && $npm_execpath run build:config",
    "build:config": "cp config/config.skel.js dist/",
    "preview": "$npm_execpath run build && vite preview",
    "test:unit": "vitest src/",
    "test:unit:coverage": "vitest --coverage src/",
    "lint": "eslint --no-error-on-unmatched-pattern",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "checkCircularDeps": "madge --ts-config tsconfig.json --extensions ts --circular ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@mantine/core": "8.0.2",
    "@mantine/hooks": "8.0.2",
    "@notifycal/shared": "^4.2.1",
    "@react-oauth/google": "^0.12.1",
    "@tabler/icons-react": "^3.29.0",
    "@tanstack/react-query": "^5.64.2",
    "@tanstack/react-router": "^1.98.4",
    "@tanstack/react-table": "^8.20.6",
    "@types/luxon": "^3.4.2",
    "axios": "^1.8.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "deepmerge-ts": "^7.1.5",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.2",
    "luxon": "^3.5.0",
    "motion": "^12.0.6",
    "radash": "^12.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "zod": "^3.25.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.0",
    "@eslint/compat": "^1.2.8",
    "@eslint/js": "^9.23.0",
    "@faker-js/faker": "^9.4.0",
    "@hookform/devtools": "^4.3.2",
    "@storybook/addon-docs": "^9.0.4",
    "@storybook/addon-links": "^9.0.4",
    "@storybook/addon-themes": "^9.0.4",
    "@storybook/react-vite": "^9.0.4",
    "@tailwindcss/postcss": "^4.1.2",
    "@tanstack/eslint-plugin-query": "^5.62.9",
    "@tanstack/eslint-plugin-router": "^1.92.7",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@tanstack/react-table-devtools": "^8.20.6",
    "@tanstack/router-devtools": "^1.97.3",
    "@tanstack/router-plugin": "^1.95.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^9.0.4",
    "eslint-plugin-unicorn": "^59.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "madge": "^8.0.0",
    "msw": "^2.7.0",
    "postcss": "8.5.5",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "storybook": "^9.0.4",
    "tailwindcss": "^4.1.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.2.6",
    "vite-plugin-static-copy": "^3.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
