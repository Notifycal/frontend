{
  "name": "vite-react-boilerplate",
  "author": "Notifycal",
  "description": "Private-area frontend SPA",
  "keywords": [
    "vite",
    "react",
    "tanstack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Notifycal/frontend"
  },
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "$npm_execpath run build && vite preview",
    "test:unit": "vitest src/",
    "test:unit:coverage": "vitest --coverage src/",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint '**/*.{js,ts,jsx,tsx,cjs,mjs}' --no-error-on-unmatched-pattern",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "storybook": "storybook dev -p 6006",
    "storybook:setup": "node node_modules/@storybook/addon-styling/bin/postinstall.js",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "7.15.0",
    "@mantine/hooks": "7.15.0",
    "@tabler/icons-react": "^3.24.0",
    "@tanstack/react-query": "^5.53.1",
    "@tanstack/react-router": "^1.51.6",
    "@tanstack/react-table": "^8.20.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "i18next": "^23.14.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^2.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-i18next": "^15.0.1",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.9.1",
    "@faker-js/faker": "^8.4.1",
    "@headlessui/react": "^2.1.3",
    "@heroicons/react": "^2.1.5",
    "@hookform/devtools": "^4.3.1",
    "@playwright/test": "^1.46.1",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-themes": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@tanstack/react-query-devtools": "^5.53.1",
    "@tanstack/react-table-devtools": "^8.20.5",
    "@tanstack/router-devtools": "^1.51.6",
    "@tanstack/router-plugin": "^1.51.6",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@total-typescript/ts-reset": "^0.6.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "@vitest/coverage-v8": "2.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-storybook": "0.11.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "postcss": "8.4.49",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "shx": "^0.3.4",
    "storybook": "^8.2.9",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "5.4.2",
    "vite-plugin-static-copy": "^1.0.6",
