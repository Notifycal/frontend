{
  "name": "vite-react-boilerplate",
  "author": "Notifycal",
  "description": "Private-area frontend SPA",
  "keywords": [
    "vite",
    "react",
    "tanstack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Notifycal/frontend"
  },
  "license": "MIT",
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "types": "tsc",
    "dev": "$npm_execpath run dev:config && vite",
    "dev:config": "cp config/config.local.js public/config.js",
    "build": "rm -rf public/config.js && tsc && vite build && $npm_execpath run build:config",
    "build:config": "cp config/config.skel.js dist/",
    "preview": "$npm_execpath run build && vite preview",
    "test:unit": "vitest src/",
    "test:unit:coverage": "vitest --coverage src/",
    "lint": "eslint --no-error-on-unmatched-pattern",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "7.15.0",
    "@mantine/hooks": "7.15.0",
    "@react-oauth/google": "^0.12.1",
    "@tabler/icons-react": "^3.28.1",
    "@tanstack/react-query": "^5.64.2",
    "@tanstack/react-router": "^1.95.5",
    "@tanstack/react-table": "^8.20.6",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "i18next": "^23.14.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.2",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.2",
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.9.1",
    "@faker-js/faker": "^9.4.0",
    "@hookform/devtools": "^4.3.2",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.5.2",
    "@storybook/addon-themes": "^8.5.1",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@tanstack/eslint-plugin-query": "^5.62.9",
    "@tanstack/eslint-plugin-router": "^1.92.7",
    "@tanstack/react-query-devtools": "^5.62.15",
    "@tanstack/react-table-devtools": "^8.20.6",
    "@tanstack/router-devtools": "^1.97.3",
    "@tanstack/router-plugin": "^1.95.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@total-typescript/ts-reset": "^0.6.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "@vitest/coverage-v8": "3.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-storybook": "^0.11.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.9.0",
    "jsdom": "^26.0.0",
    "postcss": "8.4.49",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.11",
    "vite-plugin-static-copy": "^2.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "2.0.5"
  }
}
